# Copy to .env.local and fill in. .env.local is gitignored and never pushed.

# Nicrron x Ninoo (model gateway for all agent LLM calls)
NICRRON_API_KEY=
NICRRON_BASE_URL=
NICRRON_MODEL=

# ElevenLabs (voice agent for the failure report call and booking)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Agora (reseller market for the refurbished unit)
AGORA_API_KEY=
AGORA_BASE_URL=

# PRISM by Block Convey (agent tracing and tests)
PRISM_API_KEY=
PRISM_BASE_URL=
PRISM_PROJECT_ID=
PRISM_ORG_ID=
